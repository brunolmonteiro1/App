# STCOP_LOGIN_URL=https://sistema.tagassistencia.com.br/login
# STCOP_HOST=tagassistencia.com.br
#
# CREDENCIAIS: preencher SÓ aqui, no VPS. Nunca em chat, código ou prompt.
STCOP_USERNAME=preencher_no_servidor
STCOP_PASSWORD=preencher_no_servidor

# --- Google Sheets (mesma planilha do piloto) ---
SHEET_ID=1eHqd_ErtLIv5WuyZxDMaeQ2h84oUazcs7agFQwwzfpc
