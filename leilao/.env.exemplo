# Copie para .env e ajuste. O compose lê este arquivo no serviço `gerar`.

# URL do evento da semana. O auction.id sai do sufixo do slug.
EVENTO=https://www.superbid.net/evento/logistica-reversa-790754

# Custo de retirada por lote, em reais. Enquanto for 0, o estudo marca o custo como
# INCOMPLETO — o que é honesto, não um bug.
FRETE=0
