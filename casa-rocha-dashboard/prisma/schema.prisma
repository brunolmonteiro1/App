generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Sermon {
  id                    String   @id @default(cuid())
  notebookSourceId      String   @unique
  contentHash           String
  title                 String
  normalizedTitle       String
  messageNumber         Int?
  series                String?
  seriesRaw             String?
  preacher              String?
  dateEstimated         DateTime?
  dateConfidence        String?
  year                  Int?
  youtubeUrl            String?
  youtubeId             String?  @unique
  sourceType            String
  isSermon              Boolean  @default(true)
  durationRaw           String?
  durationSeconds       Int?
  transcriptText        String
  transcriptCharCount   Int
  transcriptWordCount   Int
  transcriptQualityFlag String?
  metadataConflict      String?
  importStatus          String   @default("imported")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  analysis   SermonAnalysis?
  scores     SermonScores?
  evidence   SermonEvidence[]
  references BiblicalReference[]
  lexical    LexicalMetric[]
  saturation SaturationMetric?
  attempts   CodingAttempt[]
  repairs    CodingRepairSuggestion[]
  reviewEvents HumanReviewEvent[]

  @@index([year])
  @@index([series])
  @@map("sermons")
}

model SermonAnalysis {
  id                         String    @id @default(cuid())
  sermonId                   String    @unique
  analysisStatus             String    @default("pending")
  analysisVersion            Int       @default(1)
  aiModel                    String?
  aiCodedAt                  DateTime?
  aiError                    String?
  aiScoresJson               String?   // snapshot dos scores originais da IA → concordância IA×revisor
  reviewStatus               String?
  reviewedBy                 String?
  reviewedAt                 DateTime?
  confidenceGlobal           String?
  biblicalMainText           String?
  biblicalBooksCited         String?
  testamentPredominant       String?
  sermonType                 String?
  mainTheme                  String?
  secondaryThemes            String?
  doctrineMain               String?
  doctrinesSecondary         String?
  pastoralTone               String?
  formativeFocus             String?
  individualVsCommunityFocus String?
  theologicalLevel           String?
  languageComplexityScore    Int?
  ontologicalVsPragmatic     String?
  // Campos categóricos contextuais novos (BLUEPRINT v2 §12/§8.4)
  applicationMode              String?
  discourseMode                String?
  critiqueShareEstimate        String?
  criticTarget                 String?
  criticTone                   String?
  healthyOrDemobilizingCritique String?
  politicalCritiqueTarget      String?
  needsHumanReview             Boolean  @default(false)
  reviewReason                 String?
  sensitivityLevel             String?
  summary3Lines              String?
  mainApplication            String?
  possibleFormativeGap       String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  sermon Sermon @relation(fields: [sermonId], references: [id])

  @@map("sermon_analysis")
}

model SermonScores {
  id       String @id @default(cuid())
  sermonId String @unique

  biblicalHealthScore        Int?
  homileticExpositionScore   Int?
  christocentricReadingScore Int?
  biblicalApplicationScore   Int?

  orthodoxyScore       Int?
  trinityScore         Int?
  theologyProperScore  Int?
  christologyScore     Int?
  crucicentrismScore   Int?
  soteriologyScore     Int?
  pneumatologyScore    Int?
  bibliologyScore      Int?
  ecclesiologyScore    Int?
  eschatologyScore     Int?
  anthropologyScore    Int?
  hamartiologyScore    Int?
  sanctificationScore  Int?
  kingdomTheologyScore Int?

  orthopraxyScore                Int?
  serviceDiaconiaScore           Int?
  generosityScore                Int?
  missionEvangelismScore         Int?
  discipleshipScore              Int?
  communityMutualityScore        Int?
  hospitalityScore               Int?
  careForPoorScore               Int?
  forgivenessReconciliationScore Int?
  vocationWorkScore              Int?
  familyRelationshipsScore       Int?
  financeStewardshipScore        Int?

  spiritualityScore         Int?
  prayerScore               Int?
  scriptureDevotionScore    Int?
  fastingScore              Int?
  worshipScore              Int?
  repentanceScore           Int?
  discernmentScore          Int?
  spiritualDisciplinesScore Int?

  pastoralHealthScore             Int?
  religiousDeconstructionScore    Int?
  discipleshipReconstructionScore Int?
  practicalActivationScore        Int?
  healingWoundedScore             Int?
  sendingHealedScore              Int?
  coresponsibilityScore           Int?
  passivityRiskScore              Int?
  cynicismElitismRiskScore        Int?

  // Campos contextuais novos (BLUEPRINT v2 §12) — todos nullable (aditivos)
  contextualCritiqueIntensityScore Int?
  biblicalGroundingOfCritiqueScore Int?
  reconstructionAfterCritiqueScore Int?
  activationAfterCritiqueScore     Int?
  organicDiaconiaScore             Int?
  institutionalActionScore         Int?
  politicalIdolatryCritiqueScore   Int?

  practicalMethodScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sermon Sermon @relation(fields: [sermonId], references: [id])

  @@map("sermon_scores")
}

model SermonEvidence {
  id                 String   @id @default(cuid())
  sermonId           String
  category           String
  scoreField         String
  scoreValue         Int?
  evidenceQuote      String
  evidenceStartIndex Int?
  evidenceEndIndex   Int?
  keywordMatched     String?
  analyticalComment  String?
  analysisMethod     String
  confidence         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sermon Sermon @relation(fields: [sermonId], references: [id])

  @@index([sermonId])
  @@index([category])
  @@index([scoreField])
  @@map("sermon_evidence")
}

model BiblicalReference {
  id         String   @id @default(cuid())
  sermonId   String
  book       String
  bookSlug   String
  testament  String
  chapter    Int?
  verseStart Int?
  verseEnd   Int?
  rawMatch   String
  startIndex Int
  endIndex   Int
  isMainText Boolean  @default(false)
  createdAt  DateTime @default(now())

  sermon Sermon @relation(fields: [sermonId], references: [id])

  @@index([sermonId])
  @@index([bookSlug])
  @@map("biblical_references")
}

model LexicalMetric {
  id            String   @id @default(cuid())
  sermonId      String
  theme         String
  term          String?
  rawCount      Int
  densityPer10k Float
  createdAt     DateTime @default(now())

  sermon Sermon @relation(fields: [sermonId], references: [id])

  @@unique([sermonId, theme, term])
  @@index([theme])
  @@map("lexical_metrics")
}

model SaturationMetric {
  id                  String   @id @default(cuid())
  sermonId            String   @unique
  iscRatio            Float?
  criticDensityPer10k Float
  gospelDensityPer10k Float
  criticRawCount      Int
  gospelRawCount      Int
  saturationLabel     String?
  thresholdUsed       Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sermon Sermon @relation(fields: [sermonId], references: [id])

  @@map("saturation_metrics")
}

model CodebookCategory {
  id               String   @id @default(cuid())
  fieldName        String
  label            String
  axis             String
  description      String
  score0Definition String
  score1Definition String
  score2Definition String
  score3Definition String
  score4Definition String
  score5Definition String
  examplesPositive String?
  examplesNegative String?
  keywords         String?
  version          Int      @default(1)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([fieldName, version])
  @@map("codebook_categories")
}

model BenchmarkTopic {
  id        String   @id @default(cuid())
  topic     String   @unique
  baseTexts String
  axis      String
  category  String
  notes     String?
  createdAt DateTime @default(now())

  @@map("benchmark_topics")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model ImportRun {
  id             String    @id @default(cuid())
  fileName       String
  exportedAt     DateTime?
  sourcesTotal   Int
  sourcesNew     Int
  sourcesUpdated Int
  sourcesSkipped Int
  conflicts      String?
  createdAt      DateTime  @default(now())

  @@map("import_runs")
}

// ─────────────────────────────────────────────
// Tentativas de IA (BLUEPRINT_MESTRE_v2 §8.7/§19) — IMUTÁVEIS, nunca sobrescritas.
// Toda chamada de codificação/reparo/auditoria grava uma linha ANTES da validação.
// NUNCA persistir a chave da API aqui.
// ─────────────────────────────────────────────
model CodingAttempt {
  id                    String   @id @default(cuid())
  sermonId              String
  parentAttemptId       String?  // encadeia RETRY/EVIDENCE_REPAIR/AUDIT ao INITIAL_CODING
  attemptType           String   // INITIAL_CODING | RETRY | EVIDENCE_REPAIR | AUDIT
  model                 String
  status                String   // SUCCESS | FAILED_JSON | FAILED_SCHEMA | FAILED_VALIDATION | FAILED_EVIDENCE_LOCATION | FAILED_OPENROUTER | REPAIRABLE_EVIDENCE_GAP | HUMAN_REVIEW_REQUIRED
  failStage             String?  // etapa amigável em que falhou
  rawResponseText       String?  // resposta bruta do modelo
  extractedJson         String?  // JSON extraído (pode falhar)
  validationIssuesJson  String?  // erros Zod
  businessRuleIssuesJson String? // regras de negócio violadas
  evidenceValidationJson String? // resultado da localização de evidências
  openrouterMetaJson    String?  // usage/tokens retornados pelo provedor
  promptVersion         String?
  schemaVersion         String?
  createdAt             DateTime @default(now())

  sermon Sermon @relation(fields: [sermonId], references: [id])

  @@index([sermonId])
  @@index([status])
  @@map("coding_attempts")
}

// ─────────────────────────────────────────────
// Sugestões de reparo de score (BLUEPRINT v2 §8.8/§18) — NUNCA aplicadas
// automaticamente. Criar a sugestão não altera sermon_scores. Só ação humana
// autorizada aplica, gerando evento de revisão com antes/depois.
// ─────────────────────────────────────────────
model CodingRepairSuggestion {
  id                    String    @id @default(cuid())
  sermonId              String
  codingAttemptId       String?
  scoreField            String
  originalScore         Int?
  suggestedScore        Int?
  suggestionReason      String?
  missingEvidenceReason String?
  suggestedByModel      String?
  promptVersion         String?
  status                String    @default("PENDING") // PENDING | APPLIED | REJECTED | SUPERSEDED
  reviewedBy            String?
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sermon Sermon @relation(fields: [sermonId], references: [id])

  @@index([sermonId])
  @@index([status])
  @@map("coding_repair_suggestions")
}

// ─────────────────────────────────────────────
// Eventos de revisão humana (BLUEPRINT v2 §8.9) — trilha antes/depois de toda
// mudança de score/evidência/aplicação de sugestão.
// ─────────────────────────────────────────────
model HumanReviewEvent {
  id           String   @id @default(cuid())
  sermonId     String
  entityType   String   // score | evidence | suggestion | analysis
  entityId     String?
  action       String   // change_score | approve | reject | apply_suggestion | reject_suggestion
  fieldName    String?
  oldValueJson String?
  newValueJson String?
  reason       String?
  performedBy  String?
  performedAt  DateTime @default(now())

  sermon Sermon @relation(fields: [sermonId], references: [id])

  @@index([sermonId])
  @@map("human_review_events")
}

// ─────────────────────────────────────────────
// Relatório do Modo Diagnóstico Interno (Master Diagnostic View, BLUEPRINT v2
// §8.10/§35). Persistido e versionado — nova versão nunca apaga a anterior.
// ─────────────────────────────────────────────
model MasterDiagnosticReport {
  id                        String   @id @default(cuid())
  generatedBy               String?
  filtersJson               String?
  inputMetricsHash          String?
  inputDenominatorJson      String?
  promptVersion             String?
  model                     String?
  hardnessLevel             String   @default("MODERATE") // MODERATE | DIRECT | VERY_DIRECT
  datasetJson               String?  // payload agregado enviado ao modelo (snapshot)
  reportJson                String?  // saída validada
  rawResponseText           String?
  source                    String   @default("deterministic") // deterministic | ai
  includesPreliminaryData   Boolean  @default(false)
  reviewedOnly              Boolean  @default(true)
  includesLexicalSignals    Boolean  @default(false)
  includesSensitiveSnippets Boolean  @default(false)
  status                    String   @default("GENERATED") // GENERATED | REVIEWED | ARCHIVED
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([status])
  @@map("master_diagnostic_reports")
}

// ─────────────────────────────────────────────
// Trilha de segurança (BLUEPRINT v2 §8.11/§7.4) — acessos e ações no Modo
// Diagnóstico Interno, permitidos e negados. Nunca registra transcrições nem
// segredos; metadataJson guarda apenas contexto não sensível.
// ─────────────────────────────────────────────
model SecurityAuditLog {
  id            String   @id @default(cuid())
  userLabel     String?  // rótulo informado no login master (não é conta de e-mail)
  action        String   // master_login | master_login_denied | master_view | master_generate | master_review | master_logout
  resourceType  String?
  resourceId    String?
  route         String?
  result        String   // allowed | denied
  metadataJson  String?
  ipHash        String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@map("security_audit_logs")
}
